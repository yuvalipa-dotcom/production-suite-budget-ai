      "available_at": "as_of",
      "role": "feature",
      "type": "integer"
    },
    "n_commitments_active": {
      "available_at": "as_of",
      "role": "feature",
      "type": "integer"
    },
    "n_manual_costs": {
      "available_at": "as_of",
      "role": "feature",
      "type": "integer"
    },
    "n_substitutions_to_date": {
      "available_at": "as_of",
      "role": "feature",
      "type": "integer"
    },
    "no_vat_share": {
      "available_at": "as_of",
      "role": "feature",
      "type": "number",
      "unit": "ratio"
    },
