{
  "columns": {
    "archetype": {
      "allowed": [
        "wedding",
        "bar_bat_mitzvah",
        "corporate",
        "conference"
      ],
      "available_at": "as_of",
      "role": "feature",
      "type": "string"
    },
    "as_of_date": {
      "available_at": "as_of",
      "role": "metadata",
      "type": "date"
    },
    "batch_id": {
      "available_at": "as_of",
      "role": "metadata",
      "type": "string"
    },
    "budget_gap_ils": {
      "available_at": "financial_close",
      "note": "final_cost + (fee_contract if fee_included) - budget, signed",
      "role": "target",
      "type": "number",
      "unit": "ILS pre-VAT"
    },
    "budget_pre_vat": {
      "available_at": "as_of",
      "role": "feature",
      "type": "number",
      "unit": "ILS pre-VAT"
