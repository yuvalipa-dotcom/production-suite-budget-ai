        "role": "metadata"
      },
      "is_synthetic": {
        "role": "metadata"
      },
      "stage": {
        "role": "feature"
      },
      "as_of_date": {
        "role": "feature"
      }
    },
    "snapshots": {
      "production_id": {
        "role": "metadata"
      },
      "batch_id": {
        "role": "metadata"
      },
      "is_synthetic": {
        "role": "metadata"
      },
      "stage": {
        "role": "feature"
      },
      "as_of_date": {
        "role": "metadata"
      },
      "event_date": {
        "role": "metadata"
