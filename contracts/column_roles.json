      },
      "selected_date": {
        "role": "feature"
      },
      "cancelled_date": {
        "role": "feature"
      },
      "replaces_commitment_id": {
        "role": "metadata"
      },
      "final_pre_vat": {
        "role": "outcome-only",
        "note": "verified final supplier cost; known only at financial close; target construction only"
      }
    },
    "manual_costs": {
