{
  "contract": "column roles and availability",
  "synthetic": true,
  "version": 1,
  "roles": {
    "feature": "known at prediction time; may be used, directly or through a derived variable, to build snapshot features (subject to the as-of rule)",
    "outcome-only": "known only after financial close; may be used only to construct targets; must never enter any snapshot feature, directly or through any derived variable",
    "metadata": "identifiers, provenance, evaluation-protocol fields or columns not used by features or targets; never a model input"
  },
  "as_of_rule": "a record is available to a snapshot only if its date (selected_date, created_date, effective_date) is on or before the snapshot's as_of_date; cancellation counts only if cancelled_date is on or before as_of_date",
  "tables": {
    "productions": {
      "production_id": {
        "role": "metadata"
      },
      "batch_id": {
        "role": "metadata"
      },
      "is_synthetic": {
        "role": "metadata"
      },
      "archetype": {
        "role": "feature"
      },
      "contract_date": {
        "role": "feature"
      },
      "event_date": {
        "role": "feature"
      },
      "financial_close_date": {
        "role": "outcome-only",
        "note": "known only after financial close; target construction only"
      },
      "budget_vat_mode": {
        "role": "feature"
      },
      "initial_budget_entered": {
        "role": "feature"
      },
      "final_budget_entered": {
        "role": "outcome-only"
      },
      "fee_mode": {
        "role": "feature"
      },
      "fee_value": {
        "role": "feature"
      },
      "fee_vat_mode": {
        "role": "feature"
      },
      "fee_included": {
        "role": "feature"
      },
      "n_budget_revisions": {
        "role": "outcome-only"
      },
      "final_cost_pre_vat": {
        "role": "outcome-only"
      },
      "final_fee_contract_pre_vat": {
        "role": "outcome-only"
      },
      "fee_concession_pre_vat": {
        "role": "outcome-only",
        "note": "granted at close; affects company profit only, never the overrun label"
      },
      "final_company_profit_pre_vat": {
        "role": "outcome-only"
      },
      "split": {
        "role": "metadata"
      },
      "cv_fold": {
        "role": "metadata"
      }
    },
    "budget_revisions": {
      "production_id": {
        "role": "metadata"
      },
      "batch_id": {
        "role": "metadata"
      },
      "is_synthetic": {
        "role": "metadata"
      },
      "revision_no": {
        "role": "feature"
      },
      "effective_date": {
        "role": "feature"
      },
      "approved_entered_amount": {
