    "category_plans": {
      "production_id": {
        "role": "metadata"
      },
      "batch_id": {
        "role": "metadata"
      },
      "is_synthetic": {
        "role": "metadata"
      },
      "category": {
        "role": "feature"
      },
      "planned_entered": {
        "role": "feature"
      },
      "vat_mode": {
        "role": "feature"
      },
      "effective_date": {
        "role": "feature"
      }
    },
    "commitments": {
      "commitment_id": {
        "role": "metadata"
      },
      "production_id": {
        "role": "metadata"
      },
      "batch_id": {
        "role": "metadata"
